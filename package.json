{
  "name": "magpie",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=25.8.1 <27"
  },
  "scripts": {
    "dev": "bun --filter @magpie/web dev",
    "build": "bun --filter @magpie/web build",
    "start": "bun --filter @magpie/web start",
    "lint": "bun --filter @magpie/web lint && bun run lint:comments",
    "lint:comments": "eslint --quiet .",
    "sync": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs sync",
    "setup": "bun packages/engine/bin/setup.mjs",
    "service:install": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs service install",
    "service:uninstall": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs service uninstall",
    "open": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs open",
    "service:status": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs service status",
    "secrets:set-jev": "bun packages/engine/bin/with-node.mjs packages/engine/bin/magpie.mjs secrets set-jev",
    "build:markdown": "bun --filter @magpie/engine build:markdown",
    "test": "node --test 'packages/engine/test/**/*.test.ts' 'packages/skill/test/**/*.test.mjs' 'apps/web/test/**/*.test.ts' 'eslint-rules/**/*.test.mjs'",
    "typecheck": "bun --filter @magpie/engine typecheck && bun --filter @magpie/web typecheck",
    "categorize": "bun packages/engine/bin/with-node.mjs packages/engine/bin/categorize.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
