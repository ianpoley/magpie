{
  "name": "x-corpus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=25.8.1 <27"
  },
  "scripts": {
    "dev": "bun --filter @x-corpus/web dev",
    "build": "bun --filter @x-corpus/web build",
    "start": "bun --filter @x-corpus/web start",
    "lint": "bun --filter @x-corpus/web lint",
    "sync": "bun --filter @x-corpus/engine sync",
    "build:markdown": "bun --filter @x-corpus/engine build:markdown",
    "test": "node --test 'packages/engine/test/**/*.test.ts' 'packages/skill/test/**/*.test.mjs' 'apps/web/test/**/*.test.ts'",
    "typecheck": "bun --filter @x-corpus/engine typecheck && bun --filter @x-corpus/web typecheck",
    "categorize": "bun --filter @x-corpus/engine categorize"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
