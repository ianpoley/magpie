{
  "name": "magpie",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=25.8.1 <27"
  },
  "scripts": {
    "dev": "bun --filter @magpie/web dev",
    "build": "bun --filter @magpie/web build",
    "start": "bun --filter @magpie/web start",
    "lint": "bun --filter @magpie/web lint",
    "sync": "bun --filter @magpie/engine sync",
    "setup": "bun packages/engine/bin/setup.mjs",
    "service:install": "node packages/engine/bin/magpie.mjs service install",
    "service:uninstall": "node packages/engine/bin/magpie.mjs service uninstall",
    "service:status": "node packages/engine/bin/magpie.mjs service status",
    "secrets:set-jev": "node packages/engine/bin/magpie.mjs secrets set-jev",
    "migrate": "node packages/engine/bin/magpie.mjs migrate",
    "build:markdown": "bun --filter @magpie/engine build:markdown",
    "test": "node --test 'packages/engine/test/**/*.test.ts' 'packages/skill/test/**/*.test.mjs' 'apps/web/test/**/*.test.ts'",
    "typecheck": "bun --filter @magpie/engine typecheck && bun --filter @magpie/web typecheck",
    "categorize": "bun --filter @magpie/engine categorize"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
